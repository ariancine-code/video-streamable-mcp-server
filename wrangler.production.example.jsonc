// The shape of wrangler.production.jsonc, with stand-in values. Copy it to that name and
// put in your own: the real file is gitignored. Tests serve this file as "production"
// in process, and the workerd smoke run starts it when the real file is absent.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "video-mcp",
  "account_id": "<your-account-id>",
  "workers_dev": true,
  // The deploy fails if either secret is missing. Set them with
  // `wrangler secret put NAME --config wrangler.production.jsonc`.
  "secrets": { "required": ["GEMINI_API_KEY", "BEARER_TOKEN"] },
  "vars": {
    "NODE_ENV": "production",
    "MCP_PUBLIC_URL": "https://video-mcp.example.workers.dev/mcp",
    "MCP_ALLOWED_HOSTS": "video-mcp.example.workers.dev",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "video-mcp.example.workers.dev,claude.ai,claude.com,alice.example.org,ai.example.net,agi.example.net,example.org",
    "MCP_LEGACY_MODE": "stateless",
    "MCP_MAX_REQUEST_BYTES": "1048576",
    // Every call spends Gemini tokens on GEMINI_API_KEY, so callers need BEARER_TOKEN.
    "AUTH_MODE": "bearer",
    "LOG_LEVEL": "info"
  },

  // The same code and runtime as wrangler.jsonc.
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  // enable_request_signal: a client that disconnects aborts `request.signal`, so an abandoned
  // watch is cancelled on Gemini instead of running, and billing, to the end.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
